TIDECHECK_API_KEY=tc_live_your_key_here
OPEN_METEO_API_KEY=your_open_meteo_customer_key_here

# Resend email verification.
# Create a Resend API key, verify your sending domain, then copy these into
# apps/api_fastapi/.env. Do not commit real keys.
RESEND_API_KEY=re_your_key_here
AUTH_EMAIL_FROM="Tydes <verify@send.tydes.io>"
APP_NAME=Tydes

# Production deploy config. Keep localhost values for local development.
PUBLIC_BACKEND_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=*
TYDES_DATA_DIR=./data

# Production media storage. Direct uploads require explicit ALLOWED_ORIGINS
# instead of "*" so the R2 bucket can receive a restricted browser CORS rule.
MEDIA_STORAGE_BACKEND=local
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=

# Conservative launch limits. Increase these intentionally as Tydes grows.
SOCIAL_DAILY_POST_LIMIT=20
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_UPLOADS_PER_MINUTE=4
MEDIA_VIDEOS_PER_USER_DAY=10
MEDIA_UPLOADS_PER_USER_DAY=40
MEDIA_USER_BYTES_PER_DAY=734003200
MEDIA_GLOBAL_BYTES_PER_DAY=2147483648
MEDIA_GLOBAL_UPLOADS_PER_DAY=2000
MEDIA_GLOBAL_RETAINED_BYTES=53687091200
